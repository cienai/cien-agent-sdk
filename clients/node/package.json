{
  "name": "@cien/cien-agent-sdk",
  "version": "0.1.0",
  "description": "Node.js SDK for cien-agent-os public and admin REST APIs",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "tsconfig.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run typecheck"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  }
}
